# Jarvis local configuration. Copy to .env — NEVER commit the real file.
# No paid API keys are required. Claude/Codex run through their authenticated CLIs.

# Where Jarvis keeps its database, worktrees, artifacts and model cache.
JARVIS_HOME=

# Orchestrator HTTP port
JARVIS_PORT=4319
# Exact comma-separated browser origins allowed for authenticated control mutations.
# Defaults include the configured local UI/API ports on 127.0.0.1 and localhost.
# JARVIS_CONTROL_ORIGINS=http://127.0.0.1:5199,http://localhost:5199

# Agent defaults
JARVIS_CLAUDE_MODEL=sonnet
JARVIS_CLAUDE_PERMISSION_MODE=acceptEdits
JARVIS_CODEX_MODEL=
# Optional routing overrides when one subscription is quota-limited.
# JARVIS_IMPLEMENTER_PROVIDER=codex
# JARVIS_REVIEWER_PROVIDER=codex

# Memory / retrieval
JARVIS_EMBEDDINGS=on
JARVIS_EMBEDDING_MODEL=Xenova/multilingual-e5-small
JARVIS_MEMORY_MIN_IMPORTANCE=0.35
JARVIS_CONTEXT_BUDGET_TOKENS=2400

# Pipeline
JARVIS_MAX_FIX_CYCLES=1
JARVIS_MAX_REVIEW_FIX_CYCLES=2
JARVIS_MAX_VISUAL_FIX_CYCLES=2
JARVIS_AGENT_STAGE_RETRIES=2
# Verification setup/spawn/timeout retry budget; infrastructure never invokes a fixer.
JARVIS_VERIFICATION_INFRA_RETRIES=2
# Comma-separated structured severities. Defaults shown.
JARVIS_CODE_REVIEW_BLOCKING_SEVERITIES=critical,high
JARVIS_VISUAL_REVIEW_BLOCKING_SEVERITIES=high,medium

# Tool execution and permissions
JARVIS_TOOL_TIMEOUT_MS=60000
# How long an unanswered permission request stays answerable.
JARVIS_TOOL_APPROVAL_TTL_MS=86400000
JARVIS_TOOL_AUDIT_RETENTION_DAYS=90
# Arguments larger than this are refused, never truncated.
JARVIS_TOOL_MAX_RECORD_CHARS=4000
