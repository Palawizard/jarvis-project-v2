# Jarvis local configuration. Copy to .env — NEVER commit the real file.
# No paid API keys are required. Claude/Codex run through their authenticated CLIs.

# Where Jarvis keeps its database, worktrees, artifacts and model cache.
JARVIS_HOME=

# Orchestrator HTTP port
JARVIS_PORT=4319

# Agent defaults
JARVIS_CLAUDE_MODEL=sonnet
JARVIS_CLAUDE_PERMISSION_MODE=acceptEdits
JARVIS_CODEX_MODEL=
# Optional routing overrides when one subscription is quota-limited.
# JARVIS_IMPLEMENTER_PROVIDER=codex
# JARVIS_REVIEWER_PROVIDER=codex

# Memory / retrieval
JARVIS_EMBEDDINGS=on
JARVIS_EMBEDDING_MODEL=Xenova/multilingual-e5-small
JARVIS_MEMORY_MIN_IMPORTANCE=0.35
JARVIS_CONTEXT_BUDGET_TOKENS=2400

# Pipeline
JARVIS_MAX_FIX_CYCLES=1
