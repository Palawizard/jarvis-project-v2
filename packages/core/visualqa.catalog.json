      "expectedSelector": "[data-testid='confirm-dialog']",
      "viewports": ["desktop", "mobile"],
      "interactions": [
        {
          "action": "click",
          "selector": "[data-testid='conversation-menu-session_qafixture_chat']"
        },
        {
          "action": "click",
          "selector": "[data-testid='conversation-delete-session_qafixture_chat']"
        }
      ],
      "viewportInteractions": {
        "mobile": [
          {
            "action": "click",
            "selector": "[data-testid='mobile-drawer-open']"
          },
          {
            "action": "click",
            "selector": "[data-testid='conversation-menu-session_qafixture_chat']"
          },
          {
            "action": "click",
            "selector": "[data-testid='conversation-delete-session_qafixture_chat']"
          }
        ]
      },
      "expectedSelectorTimeoutMs": 10000
    },
