{
  "version": 1,
  "scenarios": [
    {
      "name": "chat-workspace",
      "matchers": [
        {
          "prefix": "apps/web/src/views/Chat"
        }
      ],
      "route": "/chat/session_qafixture_chat",
      "fixture": "chat-workspace",
      "expectedSelector": "[data-testid='chat-view']",
      "viewports": ["desktop", "mobile"],
      "expectedSelectorTimeoutMs": 10000
    },
    {
      "name": "conversation-menu",
      "matchers": [
        {
          "exact": "apps/web/src/App.tsx"
        }
      ],
      "route": "/chat/session_qafixture_chat",
      "fixture": "chat-workspace",
      "expectedSelector": "[data-testid='conversation-actions-session_qafixture_chat']",
      "viewports": ["desktop", "mobile"],
      "interactions": [
        {
          "action": "click",
          "selector": "[data-testid='conversation-menu-session_qafixture_chat']"
        }
      ],
      "viewportInteractions": {
        "mobile": [
          {
            "action": "click",
            "selector": "[data-testid='mobile-drawer-open']"
          },
          {
            "action": "click",
            "selector": "[data-testid='conversation-menu-session_qafixture_chat']"
          }
        ]
      },
      "expectedSelectorTimeoutMs": 10000
    },
    {
      "name": "destructive-dialog",
      "matchers": [
        {
          "exact": "apps/web/src/components.tsx"
        }
      ],
      "route": "/chat/session_qafixture_chat",
